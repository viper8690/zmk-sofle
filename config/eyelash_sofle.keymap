#define ZMK_POINTING_DEFAULT_MOVE_VAL 1200  // 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 25   // 10

#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

&mmv_input_listener { input-processors = <&zip_xy_scaler 2 1>; };

&msc_input_listener { input-processors = <&zip_scroll_scaler 2 1>; };

&msc {
    acceleration-exponent = <1>;      // 0
    time-to-max-speed-ms = <100>;       // 300
    delay-ms = <0>;                   // 0
};

&mmv {
    time-to-max-speed-ms = <500>;
    acceleration-exponent = <1>;
    trigger-period-ms = <16>;
};

&soft_off { hold-time-ms = <2000>; };

&mt {
    tapping-term-ms = <140>;
    quick-tap-ms = <175>;
    require-prior-idle-ms = <150>;
    flavor = "balanced";
};

&lt {
    tapping-term-ms = <140>;
    quick-tap-ms = <175>;
};

/ {
    scroll_encoder: scroll_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;

        tap-ms = <100>;
    };

    macros {
        // Shift+Middle Click (existing)
        SHIFT_MCLK: SHIFT_MCLK {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_SHIFT>,
                <&macro_press>,
                <&mkp MB3>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&kp LEFT_SHIFT &mkp MB3>;
            label = "SHIFT_MCLK";
        };

        // M0: Cmd+Shift+Space (Spotlight/Alfred)
        mac_spotlight: mac_spotlight {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LG(LS(SPACE))>;
            label = "MAC_SPOTLIGHT";
        };

        // M1: Cmd+C (Copy)
        mac_copy: mac_copy {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LG(C)>;
            label = "MAC_COPY";
        };

        // M2: Cmd+V (Paste)
        mac_paste: mac_paste {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LG(V)>;
            label = "MAC_PASTE";
        };
    };

    behaviors {
        // Tap dance: tap for left click, double-tap for right click
        td_click: tap_dance_click {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&mkp LCLK>, <&mkp RCLK>;
        };


    };

    combos {
        compatible = "zmk,combos";

        softoff {
            bindings = <&soft_off>;
            key-positions = <14 28 40>;
        };

        // Both shifts = Caps Lock
        caps_combo {
            bindings = <&kp CAPS>;
            key-positions = <26 46>;
            timeout-ms = <50>;
        };

        // Combo to toggle Layer 1 (Left Thumb Inner + Left Thumb Outer/BSPC)
        combo_tog1 {
             bindings = <&tog 1>;
             key-positions = <56 57>;
        };

        // Combo to toggle Layer 2 (Left Thumb Inner + Right Thumb Inner/Space)
        combo_tog2 {
            bindings = <&tog 2>;
            key-positions = <55 59>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        layer0 {
            // Silakka54-style layout with home row mods
            // Left home row: A=Shift, S=Ctrl, D=GUI, F=Alt
            // Right home row: J=Alt, K=GUI, L=Ctrl, ;=Shift
            bindings = <
&kp LS(MINUS)  &kp N1         &kp N2         &kp N3        &kp N4        &kp N5           &kp UP_ARROW     &kp N6     &kp N7        &kp N8        &kp N9         &kp N0          &kp MINUS
&kp TAB        &kp Q          &kp W          &kp E         &kp R         &kp T            &kp DOWN_ARROW   &kp Y      &kp U         &kp I         &kp O          &kp P           &kp LBKT
&kp ESC        &mt LSHFT A    &mt LCTRL S    &mt LGUI D    &mt LALT F    &kp G            &kp LEFT_ARROW   &kp H      &mt RALT J    &mt RGUI K    &mt LCTRL L    &mt RSHFT SEMI  &kp SQT
&kp LSHFT      &kp Z          &kp X          &kp C         &kp V         &kp B            &kp RIGHT_ARROW  &kp N      &kp M         &kp COMMA     &kp DOT        &kp FSLH        &kp RSHFT
&kp C_MUTE     &none          &none         &mo 2         &mo 1            &kp BSPC         &mkp LCLK        &kp SPACE        &kp ENTER  &kp RALT      &none         &none
            >;

            sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOL_DN>;
            display-name = "LAYER0";
        };

        layer_1 {
            // Layer 1 from Silakka54
            // Macros on left hand, navigation on right, media keys
            bindings = <
&trans         &trans         &trans         &trans        &trans           &trans           &mmv MOVE_UP     &kp C_MUTE    &kp C_VOL_DN  &kp C_VOL_UP  &kp MINUS     &kp EQUAL       &kp DEL
&kp GRAVE      &trans         &trans         &trans        &trans           &trans           &mmv MOVE_DOWN   &trans        &kp PG_UP     &kp UP        &kp HOME      &kp LBKT        &kp RBKT
&trans         &trans         &trans         &trans        &mac_spotlight   &trans           &mmv MOVE_LEFT   &kp LEFT      &kp DOWN      &kp UP        &kp RIGHT     &trans          &trans
&trans         &trans         &kp DEL        &mac_copy     &mac_paste       &trans           &mmv MOVE_RIGHT  &trans        &trans        &trans        &kp BSLH      &trans          &trans
&kp C_MUTE     &trans         &trans         &trans        &trans           &trans           &mkp LCLK        &td_click     &msc SCRL_UP  &msc SCRL_DOWN  &trans        &trans
            >;

            display-name = "layer1";
            sensor-bindings = <&scroll_encoder>;
        };

        layer_2 {
            // F keys on top, BT/RGB controls on left, Numpad on right
            bindings = <
&kp F1     &kp F2           &kp F3          &kp F4           &kp F5           &kp F6             &mmv MOVE_UP     &kp F7        &kp F8           &kp F9           &kp F10        &kp F11         &kp F12
&trans     &bt BT_SEL 0     &bt BT_SEL 1    &bt BT_SEL 2     &bt BT_SEL 3     &bt BT_SEL 4       &mmv MOVE_DOWN   &trans        &kp KP_N7        &kp KP_N8        &kp KP_N9      &kp KP_PLUS     &trans
&trans     &bt BT_CLR       &bt BT_CLR_ALL  &out OUT_USB     &out OUT_BLE     &trans             &mmv MOVE_LEFT   &trans        &kp KP_N4        &kp KP_N5        &kp KP_N6      &kp KP_SLASH    &kp KP_ASTERISK
&trans     &rgb_ug RGB_OFF  &rgb_ug RGB_ON  &rgb_ug RGB_EFF  &rgb_ug RGB_EFR  &rgb_ug RGB_SPI    &mmv MOVE_RIGHT  &trans        &kp KP_N1        &kp KP_N2        &kp KP_N3      &kp KP_MINUS    &kp KP_EQUAL
&trans     &sys_reset       &trans          &bootloader      &trans           &trans             &mkp LCLK        &kp KP_ENTER  &kp KP_N0        &trans           &trans         &trans
            >;

            display-name = "layer2";
            sensor-bindings = <&scroll_encoder>;
        };

        layer_3 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans      &trans     &trans       &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans      &trans     &trans       &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans      &trans     &trans       &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &sys_reset  &soft_off  &bootloader  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans      &trans     &trans
            >;

            display-name = "layer3";
            sensor-bindings = <&scroll_encoder>;
        };

        layer_4 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
            >;

            display-name = "layer4";
            sensor-bindings = <&scroll_encoder>;
        };
    };
};
